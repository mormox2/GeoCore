{
  "name": "geocore-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "GeoCore AI-native Knowledge Operating System monorepo",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:site": "npm run build && node scripts/build-site.js",
    "deploy:vercel": "npx vercel --prod",
    "test": "npm test --workspaces",
    "test:core": "npm test --workspace=@mormox2/geocore",
    "test:cli": "npm test --workspace=@mormox2/geocore-cli",
    "test:server": "npm test --workspace=@mormox2/geocore-server",
    "test:db": "npm test --workspace=@mormox2/geocore-db",
    "test:vector": "npm test --workspace=@mormox2/geocore-vector",
    "test:next": "npm test --workspace=@mormox2/geocore-next",
    "test:ai": "npm test --workspace=@mormox2/geocore-ai",
    "test:studio": "npm test --workspace=@geocore/studio",
    "test:site": "npm test --workspace=@geocore/site",
    "test:nextjs-app": "npm test --workspace=@geocore/example-nextjs-app",
    "test:rtimidental": "npm test --workspace=@geocore/example-rtimidental",
    "test:dawajinpro": "npm test --workspace=@geocore/example-dawajinpro",
    "change": "npx changeset",
    "version-packages": "npx changeset version",
    "release": "npm run build && npx changeset publish",
    "preview:studio": "node ./packages/geocore-cli/dist/bin.js studio",
    "preview:site": "node ./apps/geocore-site/serve.js",
    "validate:rtimidental": "node ./packages/geocore-cli/dist/bin.js validate --config ./examples/rtimidental/geocore.config.json",
    "export:rtimidental": "node ./packages/geocore-cli/dist/bin.js export --config ./examples/rtimidental/geocore.config.json",
    "inspect:rtimidental": "node ./packages/geocore-cli/dist/bin.js inspect --config ./examples/rtimidental/geocore.config.json",
    "vectorize:rtimidental": "node ./packages/geocore-cli/dist/bin.js vectorize --config ./examples/rtimidental/geocore.config.json",
    "serve:rtimidental": "node ./packages/geocore-cli/dist/bin.js serve --config ./examples/rtimidental/geocore.config.json",
    "sync:rtimidental": "node ./scripts/sync-rtimidental.js",
    "validate:dawajinpro": "node ./packages/geocore-cli/dist/bin.js validate --config ./examples/dawajinpro/geocore.config.json",
    "export:dawajinpro": "node ./packages/geocore-cli/dist/bin.js export --config ./examples/dawajinpro/geocore.config.json",
    "inspect:dawajinpro": "node ./packages/geocore-cli/dist/bin.js inspect --config ./examples/dawajinpro/geocore.config.json",
    "vectorize:dawajinpro": "node ./packages/geocore-cli/dist/bin.js vectorize --config ./examples/dawajinpro/geocore.config.json",
    "serve:dawajinpro": "node ./packages/geocore-cli/dist/bin.js serve --config ./examples/dawajinpro/geocore.config.json",
    "sync:dawajinpro": "node ./scripts/sync-dawajinpro.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^20.11.0",
    "@vercel/analytics": "^2.0.1",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
