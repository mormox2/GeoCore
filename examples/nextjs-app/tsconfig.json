{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "paths": {
      "@mormox2/geocore": ["../../packages/geocore/dist/index.d.ts"],
      "@mormox2/geocore-next": ["../../packages/geocore-next/dist/index.d.ts"],
      "@mormox2/geocore-ai": ["../../packages/geocore-ai/dist/index.d.ts"],
      "@mormox2/geocore-vector": ["../../packages/geocore-vector/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"]
}
